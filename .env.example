# Hosted database (Turso/libSQL) — required in production (e.g. on Vercel),
# where the filesystem is ephemeral so a local SQLite file won't persist.
# Leave both blank for local dev: the app falls back to a local file at
# data/bookings.db automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin dashboard login (choose your own strong password)
ADMIN_PASSWORD=

# SMTP settings for sending booking confirmation / rejection emails via Nodemailer
# Example for Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gen Z Gaming Cafe <you@example.com>"
